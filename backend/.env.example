# ─────────────────────────────────────────────────────────────────────────────
#  BusApp – Environment Variables
#
#  1. Copy this file:   cp .env.example .env
#  2. Generate JWT keys: ./generate-keys.sh
#  3. Paste the output values into .env
#
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=busbooking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty to run Redis without a password (default for local dev)
REDIS_PASSWORD=

# ── Eureka Service Discovery ──────────────────────────────────────────────────
EUREKA_HOST=localhost
EUREKA_PORT=8761
# Hostname eureka-server advertises to other services (use "eureka-server" in Docker)
EUREKA_INSTANCE_HOSTNAME=localhost

# ── JWT RS256 Keys ────────────────────────────────────────────────────────────
# Base64-encoded DER format. Generated by:  ./generate-keys.sh
# user-service needs both keys; gateway-service needs only the public key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── JWT Token Expiry (milliseconds) ──────────────────────────────────────────
JWT_ACCESS_EXPIRY=900000      # 15 minutes
JWT_REFRESH_EXPIRY=604800000  # 7 days

# ── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=busapp-profiles
