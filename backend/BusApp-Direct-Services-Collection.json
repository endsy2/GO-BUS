{
  "info": {
    "name": "BusApp Microservices — Direct Service URLs",
    "_postman_id": "busapp-collection-direct-004",
    "description": "All endpoints call services directly (bypassing the API Gateway). user-service=8081, bus-service=8082, booking-service=8083. Set access_token after Login/Register.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "user_service_url",    "value": "http://localhost:8081" },
    { "key": "bus_service_url",     "value": "http://localhost:8082" },
    { "key": "booking_service_url", "value": "http://localhost:8083" },
    { "key": "access_token",        "value": "" },
    { "key": "refresh_token",       "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth  [user-service :8081]",
      "item": [
        {
          "name": "Register",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "if (j.data) {",
                "  pm.collectionVariables.set('access_token',  j.data.accessToken);",
                "  pm.collectionVariables.set('refresh_token', j.data.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"johndoe\",\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"012-345-6789\",\n  \"password\": \"password123\",\n  \"gender\": \"MALE\"\n}"
            },
            "url": { "raw": "{{user_service_url}}/api/auth/register", "host": ["{{user_service_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "if (j.data) {",
                "  pm.collectionVariables.set('access_token',  j.data.accessToken);",
                "  pm.collectionVariables.set('refresh_token', j.data.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{user_service_url}}/api/auth/login", "host": ["{{user_service_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var j = pm.response.json();",
                "if (j.data) {",
                "  pm.collectionVariables.set('access_token',  j.data.accessToken);",
                "  pm.collectionVariables.set('refresh_token', j.data.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{user_service_url}}/api/auth/refresh", "host": ["{{user_service_url}}"], "path": ["api","auth","refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{user_service_url}}/api/auth/logout", "host": ["{{user_service_url}}"], "path": ["api","auth","logout"] }
          }
        }
      ]
    },

