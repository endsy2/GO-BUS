# Development Dockerfile for Bus Service
# Standalone build - doesn't require root project

FROM gradle:8.5-jdk17
WORKDIR /app

# Copy service-specific gradle files
COPY go-bus-bus-service/gradlew ./gradlew
COPY go-bus-bus-service/gradle ./gradle
COPY go-bus-bus-service/build.gradle ./build.gradle
COPY go-bus-bus-service/settings.gradle ./settings.gradle
COPY go-bus-bus-service/src ./src

# Fix line endings and make gradlew executable (Windows compatibility)
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew

# Download dependencies (cached layer)
RUN ./gradlew dependencies --no-daemon || true

# Expose port
EXPOSE 8082

# Run with hot reload
CMD ["./gradlew", "bootRun", "--no-daemon"]
