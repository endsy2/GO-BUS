# =============================================================================
#  .gitignore — BusApp Microservices Backend
# =============================================================================

# ── Secrets & Keys ────────────────────────────────────────────────────────────
*.pem
private.pem
public.pem
**/resources/keys/
.env
.env.*
!.env.example

# ── Gradle ────────────────────────────────────────────────────────────────────
.gradle/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting
.gradletasknamecache
local.properties

# ── Compiled Java ─────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar

# The Gradle wrapper jar MUST be committed — `./gradlew` cannot start without it
# and every Dockerfile builds via the wrapper. This negation has to stay *after*
# `*.jar` above: in .gitignore the last matching rule wins.
!**/gradle/wrapper/gradle-wrapper.jar

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
**/logs/
spring.log

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/
!.idea/.gitignore

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── Eclipse ───────────────────────────────────────────────────────────────────
.classpath
.project
.settings/
bin/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Spring Boot ───────────────────────────────────────────────────────────────
HELP.md

# ── Test / Coverage reports ───────────────────────────────────────────────────
**/reports/
**/test-results/
**/jacoco/
**/surefire-reports/

# ── Generated sources ─────────────────────────────────────────────────────────
**/generated/
**/generated-sources/

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerignore

# ── Redis dump ────────────────────────────────────────────────────────────────
dump.rdb

# ── Claude Code ───────────────────────────────────────────────────────────────
CLAUDE.md
*.md
application-prod.yml