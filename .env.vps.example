# ─────────────────────────────────────────────────────────────────────────────
#  Go Bus Express — VPS deployment environment
#
#  1. Copy this file:        cp .env.vps.example .env.vps
#  2. Set REACT_APP_BASE_URL / REACT_APP_WS_URL to YOUR server's public IP.
#  3. Change the default passwords below before going live.
#  4. Deploy:
#       docker compose -f docker-compose.vps.yml --env-file .env.vps up -d --build
#
#  NOTE on JWT keys: the user-service and gateway ship with a *matching* hard-coded
#  RS256 keypair baked into their application.yml, so tokens validate out of the
#  box and you do NOT need to set JWT keys here. For a real production system you
#  should generate a fresh keypair (backend/generate-keys.sh) and wire it in.
#
#  NEVER commit .env.vps to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC ADDRESS (baked into the React admin bundle at build time) ──────────
# Replace 203.0.113.10 with your VPS's public IPv4 address. No trailing slash.
# Because everything is served through nginx on port 80, do NOT add a port.
REACT_APP_BASE_URL=http://203.0.113.10
REACT_APP_WS_URL=http://203.0.113.10/bus-service/ws/bus

# ── PostgreSQL (self-hosted container) ────────────────────────────────────────
POSTGRES_DB=busbooking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# ── Redis (self-hosted container) ─────────────────────────────────────────────
# Leave empty for no password, or set one to require AUTH.
REDIS_PASSWORD=

# ── RabbitMQ (self-hosted container) ──────────────────────────────────────────
RABBITMQ_USERNAME=busapp
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_VHOST=/

# ── MinIO object storage (self-hosted container) ──────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_NAME=busapp-profiles

# ── JWT token expiry (milliseconds) ───────────────────────────────────────────
JWT_ACCESS_EXPIRY=900000        # 15 minutes
JWT_REFRESH_EXPIRY=604800000    # 7 days

# ── Bakong KHQR payment (leave blank to disable / use sandbox) ────────────────
BAKONG_ACCOUNT_ID=
BAKONG_BASE_URL=
ACQUIRINGBANK=
MERCHANTNAME=
MOBILENUMBERSTORELABEL=
STORELABEL=
EMAIL=

# ── Telegram admin alerts (optional) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# ── CORS (single-origin via nginx => not strictly needed; * is fine) ──────────
CORS_ALLOWED_ORIGINS=*
