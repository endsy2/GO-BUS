# ─────────────────────────────────────────────────────────────────────────────
#  Go Bus Express — DEVELOPMENT environment variables
#
#  1. Copy this file:   cp .env.dev.example .env.dev
#  2. Start:            docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
#  These defaults match backend/*/application-dev.yml, so the services also
#  work from your IDE without setting anything.
#  .env.dev is git-ignored — it is safe to put your own test credentials in it.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=busbooking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis (empty = no password) ───────────────────────────────────────────────
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── MinIO object storage ──────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=busapp-profiles

# ── Optional overrides ────────────────────────────────────────────────────────
# Leave these commented out to use the defaults from application-dev.yml.
# An empty value (e.g. "EMAIL=") REPLACES the default with an empty string.
#
# Telegram admin alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ENABLED=true
#
# Bakong KHQR (e.g. point at a local payment-with-bakong server)
# BAKONG_BASE_URL=http://host.docker.internal:8000
