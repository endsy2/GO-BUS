# ─────────────────────────────────────────────────────────────────────────────
#  Admin dashboard — DEVELOPMENT settings
#
#  Loaded automatically by `npm start` (Create React App). Points at the local
#  gateway from docker-compose.dev.yml or your IDE.
#  Production values come from .env.prod as Docker build args instead.
#
#  REACT_APP_* values are compiled into the public JavaScript bundle, so
#  NEVER put a secret (password, API key, token) in this file.
# ─────────────────────────────────────────────────────────────────────────────
REACT_APP_BASE_URL=http://localhost:8080
REACT_APP_WS_URL=http://localhost:8080/bus-service/ws/bus
