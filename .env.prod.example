# ─────────────────────────────────────────────────────────────────────────────
#  Go Bus Express — PRODUCTION environment variables
#
#  1. Copy this file:        cp .env.prod.example .env.prod
#  2. Fill in every value marked REQUIRED (compose refuses to start without them).
#  3. Deploy:
#       docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
#  NEVER commit .env.prod to version control (it is git-ignored).
#  Generate strong passwords with:   openssl rand -base64 24
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC ADDRESS (REQUIRED — baked into the admin bundle at build time) ─────
# Replace 203.0.113.10 with your server's public IP or domain. No trailing slash.
# Everything is served through nginx on port 80, so do NOT add a port.
REACT_APP_BASE_URL=http://203.0.113.10
REACT_APP_WS_URL=http://203.0.113.10/bus-service/ws/bus

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=busbooking
POSTGRES_USER=postgres
# REQUIRED
POSTGRES_PASSWORD=

# ── Redis (internal network only; a password is still recommended) ────────────
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=busapp
# REQUIRED
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ── MinIO object storage ──────────────────────────────────────────────────────
MINIO_ROOT_USER=busapp
# REQUIRED — at least 8 characters
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=busapp-profiles
# Browser-reachable MinIO address used to sign profile-image URLs.
# Leave empty to use the internal address (images will not load in the browser).
MINIO_PUBLIC_ENDPOINT=

# ── JWT RS256 key pair (REQUIRED) ─────────────────────────────────────────────
# Run backend/generate-keys.sh and paste both values here. Never reuse the
# development keys: they are public in git, so anyone could forge tokens.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Token lifetime in milliseconds (15 minutes / 7 days)
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ── Default admin account (REQUIRED) ──────────────────────────────────────────
# Password for admin@busapp.com, used only when that account is first created.
ADMIN_DEFAULT_PASSWORD=

# ── Bakong KHQR payment (optional — leave blank to disable) ───────────────────
BAKONG_ACCOUNT_ID=
BAKONG_BASE_URL=
ACQUIRINGBANK=
MERCHANTNAME=
MOBILENUMBERSTORELABEL=
STORELABEL=
EMAIL=

# ── Telegram admin alerts (optional) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# ── CORS (single origin via nginx, so * is fine) ──────────────────────────────
CORS_ALLOWED_ORIGINS=*
