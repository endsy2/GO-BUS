          </elementProp>
          <elementProp name="refresh.duration" elementType="Argument">
            <stringProp name="Argument.name">refresh.duration</stringProp>
            <stringProp name="Argument.value">${__P(refresh.duration,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bakong.threads" elementType="Argument">
            <stringProp name="Argument.name">bakong.threads</stringProp>
            <stringProp name="Argument.value">${__P(bakong.threads,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bakong.rampup" elementType="Argument">
            <stringProp name="Argument.name">bakong.rampup</stringProp>
            <stringProp name="Argument.value">${__P(bakong.rampup,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
