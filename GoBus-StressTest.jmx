<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Go Bus Express - Stress Test">
      <stringProp name="TestPlan.comments">Follows STRESS_TEST_PLAN.md. Parameterized via -J props. Run CLI:
jmeter -n -t GoBus-StressTest.jmx -l results.jtl -e -o report
Override per profile e.g.:  -Jlogin.threads=200 -Jlogin.rampup=60 -Jlogin.duration=600
Disable a thread group by setting its *.threads property to 0.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">${__P(BASE_URL,go-bus-gateway-service-production.up.railway.app)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(PROTOCOL,https)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(PORT,443)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMAIL" elementType="Argument">
            <stringProp name="Argument.name">EMAIL</stringProp>
            <stringProp name="Argument.value">${__P(EMAIL,admin@gobus.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(PASSWORD,Admin123!)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SCHEDULE_ID" elementType="Argument">
            <stringProp name="Argument.name">SCHEDULE_ID</stringProp>
            <stringProp name="Argument.value">${__P(scheduleId,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEAT_IDS" elementType="Argument">
            <stringProp name="Argument.name">SEAT_IDS</stringProp>
            <stringProp name="Argument.value">${__P(seatIds,10\, 11)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seat.start" elementType="Argument">
            <stringProp name="Argument.name">seat.start</stringProp>
            <stringProp name="Argument.value">${__P(seat.start,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seat.end" elementType="Argument">
            <stringProp name="Argument.name">seat.end</stringProp>
            <stringProp name="Argument.value">${__P(seat.end,400)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="route.origin" elementType="Argument">
            <stringProp name="Argument.name">route.origin</stringProp>
            <stringProp name="Argument.value">${__P(route.origin,Phnom)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bakong.currency" elementType="Argument">
            <stringProp name="Argument.name">bakong.currency</stringProp>
            <stringProp name="Argument.value">${__P(bakong.currency,USD)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bakong.check" elementType="Argument">
            <stringProp name="Argument.name">bakong.check</stringProp>
            <stringProp name="Argument.value">${__P(bakong.check,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="login.threads" elementType="Argument">
            <stringProp name="Argument.name">login.threads</stringProp>
            <stringProp name="Argument.value">${__P(login.threads,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="login.rampup" elementType="Argument">
            <stringProp name="Argument.name">login.rampup</stringProp>
            <stringProp name="Argument.value">${__P(login.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="login.duration" elementType="Argument">
            <stringProp name="Argument.name">login.duration</stringProp>
            <stringProp name="Argument.value">${__P(login.duration,180)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="search.threads" elementType="Argument">
            <stringProp name="Argument.name">search.threads</stringProp>
            <stringProp name="Argument.value">${__P(search.threads,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="search.rampup" elementType="Argument">
            <stringProp name="Argument.name">search.rampup</stringProp>
            <stringProp name="Argument.value">${__P(search.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="search.duration" elementType="Argument">
            <stringProp name="Argument.name">search.duration</stringProp>
            <stringProp name="Argument.value">${__P(search.duration,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seatmap.threads" elementType="Argument">
            <stringProp name="Argument.name">seatmap.threads</stringProp>
            <stringProp name="Argument.value">${__P(seatmap.threads,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seatmap.rampup" elementType="Argument">
            <stringProp name="Argument.name">seatmap.rampup</stringProp>
            <stringProp name="Argument.value">${__P(seatmap.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="seatmap.duration" elementType="Argument">
            <stringProp name="Argument.name">seatmap.duration</stringProp>
            <stringProp name="Argument.value">${__P(seatmap.duration,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="busfilter.threads" elementType="Argument">
            <stringProp name="Argument.name">busfilter.threads</stringProp>
            <stringProp name="Argument.value">${__P(busfilter.threads,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="busfilter.rampup" elementType="Argument">
            <stringProp name="Argument.name">busfilter.rampup</stringProp>
            <stringProp name="Argument.value">${__P(busfilter.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="busfilter.duration" elementType="Argument">
            <stringProp name="Argument.name">busfilter.duration</stringProp>
            <stringProp name="Argument.value">${__P(busfilter.duration,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="booking.threads" elementType="Argument">
            <stringProp name="Argument.name">booking.threads</stringProp>
            <stringProp name="Argument.value">${__P(booking.threads,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="booking.rampup" elementType="Argument">
            <stringProp name="Argument.name">booking.rampup</stringProp>
            <stringProp name="Argument.value">${__P(booking.rampup,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="booking.loops" elementType="Argument">
            <stringProp name="Argument.name">booking.loops</stringProp>
            <stringProp name="Argument.value">${__P(booking.loops,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="route.threads" elementType="Argument">
            <stringProp name="Argument.name">route.threads</stringProp>
            <stringProp name="Argument.value">${__P(route.threads,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="route.rampup" elementType="Argument">
            <stringProp name="Argument.name">route.rampup</stringProp>
            <stringProp name="Argument.value">${__P(route.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="route.duration" elementType="Argument">
            <stringProp name="Argument.name">route.duration</stringProp>
            <stringProp name="Argument.value">${__P(route.duration,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scheduledetail.threads" elementType="Argument">
            <stringProp name="Argument.name">scheduledetail.threads</stringProp>
            <stringProp name="Argument.value">${__P(scheduledetail.threads,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scheduledetail.rampup" elementType="Argument">
            <stringProp name="Argument.name">scheduledetail.rampup</stringProp>
            <stringProp name="Argument.value">${__P(scheduledetail.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scheduledetail.duration" elementType="Argument">
            <stringProp name="Argument.name">scheduledetail.duration</stringProp>
            <stringProp name="Argument.value">${__P(scheduledetail.duration,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="history.threads" elementType="Argument">
            <stringProp name="Argument.name">history.threads</stringProp>
            <stringProp name="Argument.value">${__P(history.threads,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="history.rampup" elementType="Argument">
            <stringProp name="Argument.name">history.rampup</stringProp>
            <stringProp name="Argument.value">${__P(history.rampup,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="history.duration" elementType="Argument">
            <stringProp name="Argument.name">history.duration</stringProp>
            <stringProp name="Argument.value">${__P(history.duration,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="refresh.threads" elementType="Argument">
            <stringProp name="Argument.name">refresh.threads</stringProp>
            <stringProp name="Argument.value">${__P(refresh.threads,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="refresh.rampup" elementType="Argument">
            <stringProp name="Argument.name">refresh.rampup</stringProp>
